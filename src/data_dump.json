{
  "model": "recipes.recipe",
  "pk": 17,
  "fields": {
    "title": "Caesar Salad",
    "description": "Classic Caesar salad with homemade dressing and crispy croutons",
    "instructions": "1. Wash and chop romaine lettuce into bite-sized pieces.\\n2. Make dressing by mixing mayo, lemon juice, garlic, and parmesan.\\n3. Toss lettuce with dressing until coated.\\n4. Add croutons and extra parmesan on top.\\n5. Season with pepper and serve immediately.",
    "author": 1,
    "category": 6,
    "prep_time_minutes": 15,
    "cook_time_minutes": 0,
    "created_at": "2026-01-12T12:00:36.514Z",
    "updated_at": "2026-01-12T12:00:36.514Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 18,
  "fields": {
    "title": "Beef Tacos",
    "description": "Seasoned ground beef tacos with fresh toppings",
    "instructions": "1. Brown ground beef in a large pan over medium-high heat.\\n2. Add taco seasoning and water, stir well.\\n3. Simmer for 5 minutes until thickened.\\n4. Warm taco shells in oven.\\n5. Fill shells with beef, lettuce, cheese, and salsa.",
    "author": 1,
    "category": 7,
    "prep_time_minutes": 10,
    "cook_time_minutes": 20,
    "created_at": "2026-01-12T12:00:36.533Z",
    "updated_at": "2026-01-12T12:00:36.533Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 19,
  "fields": {
    "title": "Chocolate Chip Cookies",
    "description": "Chewy homemade chocolate chip cookies",
    "instructions": "1. Cream butter and sugars until fluffy.\\n2. Beat in eggs and vanilla extract.\\n3. Mix in flour, baking soda, and salt.\\n4. Fold in chocolate chips.\\n5. Bake at 375F for 9-11 minutes until edges are golden.",
    "author": 1,
    "category": 8,
    "prep_time_minutes": 15,
    "cook_time_minutes": 10,
    "created_at": "2026-01-12T12:00:36.544Z",
    "updated_at": "2026-01-12T12:00:36.544Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 20,
  "fields": {
    "title": "Grilled Cheese Sandwich",
    "description": "Classic crispy grilled cheese sandwich",
    "instructions": "1. Butter one side of each bread slice.\\n2. Place cheese between bread, butter sides out.\\n3. Grill in pan over medium heat until golden.\\n4. Flip carefully and grill other side.\\n5. Cut diagonally and serve hot.",
    "author": 1,
    "category": 6,
    "prep_time_minutes": 5,
    "cook_time_minutes": 8,
    "created_at": "2026-01-12T12:00:36.569Z",
    "updated_at": "2026-01-12T12:00:36.569Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 21,
  "fields": {
    "title": "Tomato Soup",
    "description": "Creamy homemade tomato soup perfect with grilled cheese",
    "instructions": "1. Saute diced onion and garlic in olive oil.\\n2. Add canned tomatoes and chicken broth.\\n3. Simmer for 20 minutes.\\n4. Blend until smooth with immersion blender.\\n5. Stir in cream, season with salt and pepper.",
    "author": 1,
    "category": 6,
    "prep_time_minutes": 10,
    "cook_time_minutes": 25,
    "created_at": "2026-01-12T12:00:36.579Z",
    "updated_at": "2026-01-12T12:00:36.579Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 22,
  "fields": {
    "title": "Banana Smoothie",
    "description": "Healthy and creamy banana smoothie",
    "instructions": "1. Add banana, milk, and yogurt to blender.\\n2. Add honey and a handful of ice.\\n3. Blend until completely smooth.\\n4. Pour into a tall glass.\\n5. Serve immediately.",
    "author": 1,
    "category": 10,
    "prep_time_minutes": 5,
    "cook_time_minutes": 0,
    "created_at": "2026-01-12T12:00:36.595Z",
