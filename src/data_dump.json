  }
},
{
  "model": "recipes.recipe",
  "pk": 23,
  "fields": {
    "title": "Garlic Bread",
    "description": "Crispy buttery garlic bread",
    "instructions": "1. Mix softened butter with minced garlic and parsley.\\n2. Slice baguette in half lengthwise.\\n3. Spread garlic butter generously on bread.\\n4. Broil for 3-5 minutes until golden and crispy.\\n5. Slice and serve warm.",
    "author": 1,
    "category": 9,
    "prep_time_minutes": 5,
    "cook_time_minutes": 5,
    "created_at": "2026-01-12T12:00:36.610Z",
    "updated_at": "2026-01-12T12:00:36.610Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 24,
  "fields": {
    "title": "Cheese Omelette",
    "description": "Fluffy cheese omelette for breakfast",
    "instructions": "1. Whisk eggs with salt and pepper.\\n2. Heat butter in non-stick pan over medium heat.\\n3. Pour eggs and let cook until edges set.\\n4. Add shredded cheese to one half.\\n5. Fold omelette and serve immediately.",
    "author": 1,
    "category": 5,
    "prep_time_minutes": 5,
    "cook_time_minutes": 5,
    "created_at": "2026-01-12T12:00:36.624Z",
    "updated_at": "2026-01-12T12:00:36.624Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 25,
  "fields": {
    "title": "Chicken Quesadilla",
    "description": "Cheesy chicken quesadilla with crispy tortilla",
    "instructions": "1. Shred or dice cooked chicken.\\n2. Place tortilla in dry pan over medium heat.\\n3. Add cheese and chicken to half of tortilla.\\n4. Fold tortilla and cook until crispy on both sides.\\n5. Cut into wedges and serve with salsa.",
    "author": 1,
    "category": 7,
    "prep_time_minutes": 10,
    "cook_time_minutes": 10,
    "created_at": "2026-01-12T12:00:36.635Z",
