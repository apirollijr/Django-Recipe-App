{
  "model": "recipes.recipe",
  "pk": 1,
  "fields": {
    "title": "Scrambled Eggs",
    "description": "Fluffy scrambled eggs cooked gently with butter and a pinch of salt. A quick, protein-packed meal perfect for breakfast or anytime.",
    "instructions": "Crack eggs into a bowl and whisk until combined.\r\n\r\nHeat a nonstick pan over medium-low heat and melt the butter.\r\n\r\nPour in the eggs and stir gently with a spatula.\r\n\r\nCook until just set but still soft.\r\n\r\nSeason with salt and pepper and serve.",
    "author": null,
    "category": 4,
    "prep_time_minutes": 0,
    "cook_time_minutes": 0,
    "created_at": "2025-12-24T19:34:38.028Z",
    "updated_at": "2026-01-01T15:44:13.510Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 2,
  "fields": {
    "title": "Grilled Chicken with Rice",
    "description": "Simple grilled chicken breast served with steamed rice. Clean, filling, and versatile.",
    "instructions": "Season the chicken with olive oil, salt, and pepper.\r\n\r\nHeat a grill pan or skillet over medium heat.\r\n\r\nCook chicken 6�7 minutes per side until fully cooked.\r\n\r\nBring water to a boil, add rice, cover, and simmer 15�18 minutes.\r\n\r\nServe chicken over rice.",
    "author": null,
    "category": 1,
    "prep_time_minutes": 5,
    "cook_time_minutes": 20,
    "created_at": "2025-12-24T19:37:03.846Z",
    "updated_at": "2026-01-01T15:44:01.577Z"
  }
},
{
  "model": "recipes.recipe",
  "pk": 3,
  "fields": {
    "title": "Spaghetti Marinara",
    "description": "Classic pasta tossed in a simple tomato sauce. Quick and comforting.",
    "instructions": "Boil salted water and cook spaghetti according to package directions.\r\n\r\nHeat the marinara sauce in a saucepan over low heat.\r\n\r\nDrain pasta and toss with olive oil.\r\n\r\nAdd sauce and mix well.\r\n\r\nTop with parmesan if desired.",
    "author": null,
    "category": 3,
    "prep_time_minutes": 0,
